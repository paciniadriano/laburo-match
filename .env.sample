# laburo-match settings — SAMPLE with fake values.
# The real .env lives OUTSIDE the repo (e.g. ~/.config/laburo-match/.env);
# point ENV_FILE_PATH to it. See specs/system.md §6 for details.

# --- Environment ---
# local | production
APP_ENV=local

# --- HTTP server ---
# Bind address and port (the container sets SERVER_HOST=0.0.0.0)
SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# --- Database ---
# Postgres URL (SQLAlchemy async + psycopg 3)
DATABASE_URL=postgresql+psycopg://laburo:laburo@localhost:5432/laburo
# Test database: its name must end in _test (tests abort otherwise)
TEST_DATABASE_URL=postgresql+psycopg://laburo:laburo@localhost:5432/laburo_test

# --- LLM (OpenAI, Responses API) ---
OPENAI_API_KEY=sk-fake-replace-me
# Model for every task unless a task in LLM_TASKS overrides it
LLM_BASE_MODEL=gpt-6-luna
# Terminal client ReAct loop (empty = base model)
LLM_CLIENT_MODEL=
# Eval judge only (empty = base model)
LLM_JUDGE_MODEL=

# --- Sources ---
# Google Jobs via SerpApi (optional; the source is skipped if empty)
SERPAPI_API_KEY=
# Hard monthly stop for SerpApi searches (searches, replans and fixture recording)
SERPAPI_MONTHLY_CAP=200
# Sources replay recorded fixtures instead of calling APIs (keep true until phase 4)
DEMO_MODE=true

# --- Observability (optional) ---
OPIK_API_KEY=
OPIK_PROJECT=laburo-match-local
OPIK_WORKSPACE=
# Capture profile/draft content in traces
OBS_CAPTURE_PII=false

# --- Security ---
# HMAC secret for signed upload links and user hashes.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
UPLOAD_SIGNING_SECRET=fake-signing-secret-replace-me
# Base URL used in upload links
PUBLIC_BASE_URL=http://localhost:8000
# Auth (remote only; empty locally)
DESCOPE_PROJECT_ID=

# --- Limits and tuning (most are set from measurements in phase 1) ---
# A search queues every job that passes the filters; this only stops a runaway search
MAX_NEW_JOBS_PER_SEARCH=300
# A screen_batch round stops taking jobs after this many seconds (the user waits ~30 s)
SCREEN_ROUND_SECONDS=20
# A safety limit on the jobs one round may take
SCREEN_MAX_JOBS_PER_CALL=300
CLAIM_STALE_SECONDS=300
DRAFT_LEASE_SECONDS=300
SLOW_TOOL_WARNING_SECONDS=30
LLM_CONCURRENCY=4
EXTRACTION_BATCH_SIZE=1
LINKING_CHUNK_SIZE=15
JOB_MAX_AGE_DAYS=30
DEFAULT_MAX_COMMUTE_KM=30

# --- Cost control (remote; see specs/system.md §17) ---
DAILY_COST_CEILING_USD=
